---
import { content, rich } from '../lib/content';

const c = await content('faq');
---
<section class="faq" data-theme="light" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <div>
      <p class="eyebrow" data-fade>{c.eyebrow}</p>
      <h2 id="faq-title" class="h-display" data-reveal>
        {c.title.map((l) => <span class="split-line"><span>{rich(l).map((p) => (p.em ? <em>{p.text}</em> : p.text))}</span></span>)}
      </h2>
    </div>
    <div class="faq__list">
      {c.items.map((f, i) => (
        <details class="qa" open={i === 0} data-fade={i * 0.04}>
          <summary data-cursor="Learn +">
            <span>{f.question}</span>
            <i aria-hidden="true"></i>
          </summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding: clamp(110px, 13vw, 180px) 0;
  }
  .faq__grid {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
  }
  .faq__list {
    border-top: 1px solid var(--rule);
  }
  .qa {
    border-bottom: 1px solid var(--rule);
  }
  .qa summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    cursor: pointer;
    font-size: clamp(18px, 1.6vw, 22px);
    letter-spacing: -0.015em;
    font-weight: 500;
    color: var(--forest);
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa summary i {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background 0.3s, transform 0.5s var(--ease);
  }
  .qa summary i::before,
  .qa summary i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    background: currentColor;
  }
  .qa summary i::after {
    transform: rotate(90deg);
    transition: transform 0.4s var(--ease);
  }
  .qa[open] summary i {
    background: var(--forest);
    color: var(--ivory);
  }
  .qa[open] summary i::after {
    transform: rotate(0deg);
  }
  .qa p {
    margin: 0 0 26px;
    max-width: 62ch;
    color: var(--fg-muted);
  }
  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
