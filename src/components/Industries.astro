---
// "Every business vertical": five expanding panels. The open panel shows that
// industry's equity agenda; panels advance on their own until the visitor
// hovers or picks one.
import { content, rich } from '../lib/content';

const c = await content('industries');
const verticals = c.items;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="ind" id="industries" data-theme="light" aria-labelledby="ind-title">
  <div class="wrap">
    <div class="ind__head">
      <p class="eyebrow" data-fade>{c.eyebrow}</p>
      <h2 id="ind-title" class="ind__title" data-reveal>
        {c.title.map((l) => <span class="split-line"><span>{rich(l).map((p) => (p.em ? <em class="serif">{p.text}</em> : p.text))}</span></span>)}
      </h2>
      <p class="lede" data-fade>{c.lede}</p>
    </div>

    <div class="deck" data-deck aria-label={c.tablistLabel} role="group">
      {verticals.map((v, i) => (
        <article class="leaf" data-leaf data-active={i === 0 ? '' : undefined} data-fade={i * 0.06}>
          <button
            class="leaf__tab"
            id={`tab-${v.id}`}
            aria-controls={`ind-${v.id}`}
            aria-expanded={i === 0 ? 'true' : 'false'}
          >
            <span class="leaf__k">{pad(i + 1)}</span>
            <span class="leaf__name">{v.name}</span>
            <span class="leaf__plus" aria-hidden="true"></span>
          </button>
          <div class="leaf__body" id={`ind-${v.id}`} role="region" aria-labelledby={`tab-${v.id}`}>
            <div class="leaf__inner">
              <p class="leaf__count">{pad(i + 1)} / {pad(verticals.length)}</p>
              <h3 class="leaf__title display">{v.name}</h3>
              <p class="leaf__line">{v.line}</p>
              <ul class="leaf__list">
                {v.items.map((it, k) => <li style={`--i:${k}`}><span>{it}</span></li>)}
              </ul>
            </div>
          </div>
          <span class="leaf__bar" aria-hidden="true"><i></i></span>
        </article>
      ))}
    </div>
  </div>
</section>


<script>
  import { gsap } from 'gsap';
  import { reduced } from '../scripts/site';

  const deck = document.querySelector<HTMLElement>('[data-deck]')!;
  const leaves = Array.from(deck.querySelectorAll<HTMLElement>('[data-leaf]'));
  const tabs = leaves.map((l) => l.querySelector<HTMLButtonElement>('.leaf__tab')!);
  const bars = leaves.map((l) => l.querySelector<HTMLElement>('.leaf__bar i')!);
  const DWELL = 6; // seconds each panel stays open while auto-advancing

  let active = 0;
  let visible = false;
  let hovering = false;
  let timer: gsap.core.Tween | null = null;

  function sync() {
    if (!timer) return;
    if (visible && !hovering) timer.resume();
    else timer.pause();
  }

  function run() {
    if (reduced) return;
    timer?.kill();
    gsap.set(bars, { scaleX: 0 });
    timer = gsap.to(bars[active], {
      scaleX: 1,
      duration: DWELL,
      ease: 'none',
      onComplete: () => select((active + 1) % leaves.length),
    });
    sync();
  }

  function select(i: number) {
    if (i !== active) {
      active = i;
      leaves.forEach((l, k) => l.toggleAttribute('data-active', k === i));
      tabs.forEach((t, k) => t.setAttribute('aria-expanded', String(k === i)));
    }
    run();
  }

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('focus', () => select(i));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (d) {
        e.preventDefault();
        tabs[(i + d + tabs.length) % tabs.length].focus();
      }
    });
  });

  // desktop: hovering a collapsed panel opens it; anywhere on the deck pauses the timer
  const hoverOpen = window.matchMedia('(hover: hover) and (min-width: 901px)');
  leaves.forEach((l, i) => l.addEventListener('pointerenter', () => hoverOpen.matches && i !== active && select(i)));
  deck.addEventListener('pointerenter', () => ((hovering = true), sync()));
  deck.addEventListener('pointerleave', () => ((hovering = false), sync()));

  new IntersectionObserver(([e]) => ((visible = e.isIntersecting), sync()), { threshold: 0.35 }).observe(deck);
  run();
</script>

<style>
  .ind {
    padding: clamp(120px, 14vw, 200px) 0;
  }
  .ind__head {
    display: grid;
    gap: 24px;
    max-width: 900px;
  }
  .ind__title {
    font-family: var(--f-serif);
    font-size: clamp(42px, 6.4vw, 104px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 400;
    margin: 0;
    color: var(--forest);
  }
  .ind__title em {
    color: var(--emerald);
  }

  .deck {
    display: flex;
    gap: 12px;
    height: clamp(500px, 44vw, 600px);
    container-type: inline-size;
    margin-top: clamp(40px, 6vw, 80px);
  }
  .leaf {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border-radius: 24px;
    background: color-mix(in srgb, #fff 55%, var(--ivory));
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--forest);
    transition: flex-grow 0.9s var(--ease), background 0.6s var(--ease), color 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }
  .leaf::before {
    /* the open panel's deep-green finish, faded in rather than swapped */
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 18% 12%, #1a8f6c 0%, var(--emerald) 28%, var(--forest) 72%);
    opacity: 0;
    transition: opacity 0.7s var(--ease);
  }
  .leaf:not([data-active]):hover {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--forest) 35%, transparent);
  }
  .leaf[data-active] {
    flex-grow: 4.6;
    color: var(--ivory);
    box-shadow: inset 0 0 0 1px rgba(198, 161, 91, 0.45), 0 40px 80px -40px rgba(7, 61, 50, 0.55);
  }
  .leaf[data-active]::before {
    opacity: 1;
  }

  /* collapsed face: number on top, rotated name along the bottom */
  .leaf__tab {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 28px 24px;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }
  .leaf__k {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--gold);
  }
  .leaf__name {
    font-family: var(--f-serif);
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1;
    white-space: nowrap;
    writing-mode: vertical-rl;
    rotate: 180deg;
    transition: opacity 0.35s var(--ease), translate 0.6s var(--ease);
  }
  .leaf__plus {
    position: absolute;
    top: 22px;
    right: 20px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--line);
    transition: opacity 0.35s var(--ease), rotate 0.6s var(--ease);
  }
  .leaf__plus::before,
  .leaf__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1px;
    margin: -0.5px 0 0 -5px;
    background: currentColor;
  }
  .leaf__plus::after {
    rotate: 90deg;
  }
  .leaf:not([data-active]):hover .leaf__plus {
    rotate: 90deg;
  }
  .leaf[data-active] .leaf__tab {
    pointer-events: none;
  }
  .leaf[data-active] .leaf__name,
  .leaf[data-active] .leaf__plus,
  .leaf[data-active] .leaf__k {
    opacity: 0;
    translate: 0 12px;
  }
  .leaf__k {
    transition: opacity 0.35s var(--ease), translate 0.6s var(--ease);
  }

  /* open face */
  .leaf__body {
    position: absolute;
    inset: 0;
    z-index: 2;
    visibility: hidden;
    transition: visibility 0s 0.35s;
  }
  .leaf[data-active] .leaf__body {
    visibility: visible;
    transition-delay: 0s;
  }
  .leaf__inner {
    --pad: clamp(28px, 3.4vw, 52px);
    position: absolute;
    left: var(--pad);
    bottom: clamp(28px, 3.4vw, 48px);
    top: clamp(28px, 3.4vw, 48px);
    /* fixed width so the copy never reflows while the panel is widening */
    width: calc((100cqw - 48px) * 4.6 / 8.6 - 2 * var(--pad));
    display: flex;
    flex-direction: column;
  }
  .leaf__count {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--gold-soft);
    margin: 0;
  }
  .leaf__title {
    font-family: var(--f-serif);
    font-size: clamp(38px, 4.2vw, 68px);
    line-height: 1.02;
    font-weight: 400;
    margin: 18px 0 14px;
  }
  .leaf__line {
    color: color-mix(in srgb, var(--ivory) 72%, transparent);
    margin: 0;
    max-width: 40ch;
  }
  .leaf__list {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    border-top: 1px solid rgba(245, 245, 240, 0.16);
  }
  .leaf__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(245, 245, 240, 0.16);
    font-size: clamp(17px, 1.5vw, 21px);
    letter-spacing: -0.015em;
  }
  .leaf__list li::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    flex: none;
  }
  /* staggered entrance: copy waits for the panel to widen, then rises in */
  .leaf__count,
  .leaf__title,
  .leaf__line,
  .leaf__list li {
    opacity: 0;
    translate: 0 18px;
    transition: opacity 0.25s var(--ease), translate 0.25s var(--ease);
  }
  .leaf[data-active] .leaf__count,
  .leaf[data-active] .leaf__title,
  .leaf[data-active] .leaf__line,
  .leaf[data-active] .leaf__list li {
    opacity: 1;
    translate: 0 0;
    transition: opacity 0.7s var(--ease), translate 0.9s var(--ease);
  }
  .leaf[data-active] .leaf__count {
    transition-delay: 0.35s;
  }
  .leaf[data-active] .leaf__title {
    transition-delay: 0.42s;
  }
  .leaf[data-active] .leaf__line {
    transition-delay: 0.5s;
  }
  .leaf[data-active] .leaf__list li {
    transition-delay: calc(0.58s + var(--i) * 0.07s);
  }

  /* auto-advance progress */
  .leaf__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 3;
    height: 3px;
    opacity: 0;
    transition: opacity 0.4s;
  }
  .leaf[data-active] .leaf__bar {
    opacity: 1;
  }
  .leaf__bar i {
    display: block;
    height: 100%;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* small screens: a vertical accordion */
  @media (max-width: 900px) {
    .deck {
      container-type: normal;
      flex-direction: column;
      height: auto;
      gap: 10px;
    }
    .leaf {
      flex: none;
      display: grid;
      grid-template-rows: auto 0fr;
      transition: grid-template-rows 0.7s var(--ease), background 0.6s var(--ease), color 0.6s var(--ease);
      border-radius: 18px;
    }
    .leaf[data-active] {
      grid-template-rows: auto 1fr;
    }
    .leaf__tab {
      position: relative;
      inset: auto;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 16px;
      padding: 20px 64px 20px 20px;
    }
    .leaf__name {
      writing-mode: horizontal-tb;
      rotate: none;
      font-size: 22px;
    }
    .leaf__plus {
      top: 50%;
      right: 18px;
      margin-top: -13px;
    }
    .leaf[data-active] .leaf__tab {
      pointer-events: auto;
    }
    .leaf[data-active] .leaf__name,
    .leaf[data-active] .leaf__k {
      opacity: 1;
      translate: none;
    }
    .leaf[data-active] .leaf__plus {
      opacity: 1;
      translate: none;
      rotate: 45deg;
      box-shadow: inset 0 0 0 1px rgba(245, 245, 240, 0.3);
    }
    .leaf__body {
      position: relative;
      inset: auto;
      min-height: 0;
      overflow: hidden;
    }
    .leaf__inner {
      position: static;
      width: auto;
      padding: 0 20px 24px;
    }
    .leaf__count,
    .leaf__title {
      display: none;
    }
    .leaf__list {
      margin-top: 20px;
    }
  }
</style>
