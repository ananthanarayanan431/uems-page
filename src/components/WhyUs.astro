---
const reasons = [
  {
    t: 'Custom frameworks',
    d: 'Equity structures tailored to tech startups, manufacturing enterprises, founders and investors. Never a template.',
  },
  {
    t: 'Local regulatory alignment',
    d: 'Structures designed around Indian corporate and securities regulation, executed alongside the right licensed professionals.',
  },
  {
    t: 'Specialists, hands-on',
    d: 'Equity specialists who assist at every stage of your requirements, from first cap table to complex secondary.',
  },
  {
    t: 'Zero-error discipline',
    d: 'Reconciled records and rigorous review eliminate the human errors that fragmented spreadsheets invite.',
  },
  {
    t: 'Dedicated human support',
    d: 'A named team that guides complex transactions personally, not a ticket queue.',
  },
];
---
<section class="why" data-theme="light" aria-labelledby="why-title">
  <div class="wrap why__grid">
    <div class="why__intro">
      <p class="eyebrow" data-fade>Why organisations choose us</p>
      <h2 id="why-title" class="why__title" data-reveal>
        <span class="split-line"><span>Precision is</span></span>
        <span class="split-line"><span><em class="serif">the product.</em></span></span>
      </h2>
    </div>
    <ol class="why__list">
      {reasons.map((r, i) => (
        <li class="why__row" data-fade={i * 0.05} data-cursor="Learn +" tabindex="0">
          <span class="why__n">0{i + 1}</span>
          <h3>{r.t}</h3>
          <p>{r.d}</p>
          <span class="why__plus" aria-hidden="true">+</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .why {
    padding: 0 0 clamp(120px, 14vw, 200px);
  }
  .why__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
  }
  .why__intro {
    position: sticky;
    top: 130px;
  }
  .why__title {
    font-family: var(--f-serif);
    font-size: clamp(40px, 5.2vw, 84px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 400;
    margin: 24px 0 0;
    color: var(--forest);
  }
  .why__title em {
    color: var(--emerald);
  }
  .why__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .why__row {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr 40px;
    grid-template-areas: 'n t p' '. d .';
    column-gap: 16px;
    padding: 30px 0;
    border-bottom: 1px solid var(--rule);
    outline: none;
  }
  .why__row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--forest);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.6s var(--ease);
    z-index: -1;
    border-radius: 4px;
  }
  .why__n {
    grid-area: n;
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--gold);
    padding-top: 10px;
    padding-left: 10px;
  }
  .why__row h3 {
    grid-area: t;
    margin: 0;
    font-size: clamp(24px, 2.6vw, 40px);
    letter-spacing: -0.035em;
    font-weight: 500;
    color: var(--forest);
    transition: color 0.4s;
  }
  .why__row p {
    grid-area: d;
    margin: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    color: rgba(245, 245, 240, 0.75);
    max-width: 52ch;
    transition: max-height 0.6s var(--ease), opacity 0.4s, margin 0.6s var(--ease);
  }
  .why__plus {
    grid-area: p;
    font-size: 28px;
    font-weight: 300;
    color: var(--forest);
    transition: transform 0.5s var(--ease), color 0.4s;
  }
  .why__row:hover::before,
  .why__row:focus-visible::before {
    transform: scaleY(1);
  }
  .why__row:hover h3,
  .why__row:focus-visible h3,
  .why__row:hover .why__plus,
  .why__row:focus-visible .why__plus {
    color: var(--ivory);
  }
  .why__row:hover .why__plus,
  .why__row:focus-visible .why__plus {
    transform: rotate(45deg);
  }
  .why__row:hover p,
  .why__row:focus-visible p {
    max-height: 120px;
    opacity: 1;
    margin-top: 12px;
  }
  .why__list {
    isolation: isolate;
  }
  @media (hover: none), (max-width: 900px) {
    /* no hover on touch: show everything, keep it calm */
    .why__row p {
      max-height: none;
      opacity: 1;
      margin-top: 10px;
      color: var(--fg-muted);
    }
    .why__row::before {
      display: none;
    }
    .why__row:hover h3,
    .why__row:hover .why__plus {
      color: var(--forest);
    }
  }
  @media (max-width: 900px) {
    .why__grid {
      grid-template-columns: 1fr;
    }
    .why__intro {
      position: static;
    }
    .why__row {
      grid-template-columns: 40px 1fr;
      grid-template-areas: 'n t' '. d';
    }
    .why__n {
      padding-left: 0;
    }
    .why__plus {
      display: none;
    }
  }
</style>
