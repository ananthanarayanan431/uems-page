---
// Section divider built from the equity-node motif: a rule that draws itself
// and links three nodes, the middle one gold (the company).
---
<div class="nd wrap" aria-hidden="true" data-divider>
  <svg viewBox="0 0 1000 24" preserveAspectRatio="none" class="nd__line">
    <line x1="0" y1="12" x2="1000" y2="12" />
  </svg>
  <i class="nd__n nd__n--l"></i>
  <i class="nd__n nd__n--gold"></i>
  <i class="nd__n nd__n--r"></i>
</div>

<script>
  import { gsap } from 'gsap';
  import { reduced } from '../scripts/site';

  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-divider]').forEach((d) => {
      const tl = gsap.timeline({ scrollTrigger: { trigger: d, start: 'top 90%' } });
      tl.from(d.querySelector('line'), { attr: { x2: 0 }, duration: 1.4, ease: 'power3.inOut' }).from(
        d.querySelectorAll('.nd__n'),
        { scale: 0, duration: 0.6, stagger: 0.25, ease: 'back.out(2.5)' },
        0.1,
      );
    });
  }
</script>

<style>
  .nd {
    position: relative;
    height: 24px;
    margin-top: 0;
    margin-bottom: 0;
  }
  .nd__line {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    width: calc(100% - 2 * var(--gutter));
    height: 24px;
    overflow: visible;
  }
  .nd__line line {
    stroke: var(--rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .nd__n {
    position: absolute;
    top: 7px;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-radius: 50%;
    background: var(--forest);
    left: 50%;
  }
  .nd__n--l {
    left: var(--gutter);
  }
  .nd__n--r {
    left: calc(100% - var(--gutter));
  }
  .nd__n--gold {
    width: 14px;
    height: 14px;
    top: 5px;
    margin-left: -7px;
    background: var(--gold);
    box-shadow: 0 0 0 5px rgba(198, 161, 91, 0.18);
  }
  :global(body.is-dark) .nd__n:not(.nd__n--gold) {
    background: var(--ivory);
  }
</style>
