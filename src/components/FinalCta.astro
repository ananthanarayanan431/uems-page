---
// The hero network returns, simplified and resolved.
import { content, rich } from '../lib/content';

interface Props {
  eyebrow?: string;
}
const { eyebrow } = Astro.props;
const c = await content('cta');
const site = await content('site');
---
<section class="fin" data-theme="dark" aria-labelledby="fin-title">
  <div class="wrap fin__inner">
    <svg class="fin__net" viewBox="0 0 400 300" aria-hidden="true" data-fin-net>
      <g class="fin__edges">
        <path d="M200 150 L200 40" />
        <path d="M200 150 L90 90" />
        <path d="M200 150 L310 90" />
        <path d="M200 150 L110 250" />
        <path d="M200 150 L290 250" />
        <path d="M90 90 L200 40 L310 90" class="soft" />
      </g>
      <circle cx="200" cy="150" r="16" class="fin__hub" />
      <circle cx="200" cy="150" r="30" class="fin__halo" />
      {[[200, 40], [90, 90], [310, 90], [110, 250], [290, 250]].map(([x, y]) => (
        <circle cx={x} cy={y} r="7" class="fin__node" />
      ))}
    </svg>

    <p class="eyebrow">{eyebrow ?? c.eyebrow}</p>
    <h2 id="fin-title" class="fin__title" data-reveal>
        {c.title.map((l) => <span class="split-line"><span>{rich(l).map((p) => (p.em ? <em class="serif">{p.text}</em> : p.text))}</span></span>)}
      </h2>
    <p class="fin__ask">{c.ask}</p>
    <p class="fin__lede">{c.lede}</p>
    <div class="fin__ctas">
      <a href="/contact" class="btn btn--gold" data-cursor="Explore →">
        {c.button} <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a href={`mailto:${site.email}`} class="fin__mail" data-cursor="Write ✉">{site.email}</a>
    </div>

    <dl class="fin__meta">
      <div><dt>{c.phoneLabel}</dt><dd><a href={site.phone.href}>{site.phone.display}</a></dd></div>
      <div><dt>{c.officesLabel}</dt><dd>{site.offices.join(' · ')}</dd></div>
      <div><dt>{c.onboardingLabel}</dt><dd>{c.onboarding}</dd></div>
    </dl>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { reduced } from '../scripts/site';

  if (!reduced) {
    const tl = gsap.timeline({ scrollTrigger: { trigger: '[data-fin-net]', start: 'top 80%' } });
    tl.from('.fin__hub', { scale: 0, transformOrigin: 'center', duration: 0.9, ease: 'elastic.out(1,0.5)' })
      .from('.fin__edges path', { strokeDashoffset: 200, duration: 1, stagger: 0.08, ease: 'power2.out' }, 0.2)
      .from('.fin__node', { scale: 0, transformOrigin: 'center', duration: 0.6, stagger: 0.08, ease: 'back.out(2)' }, 0.5);
  }
</script>

<style>
  .fin {
    padding: clamp(120px, 14vw, 200px) 0 clamp(80px, 8vw, 120px);
    color: #f5f5f0;
    text-align: center;
  }
  .fin__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .fin__net {
    width: min(360px, 80vw);
    margin-bottom: 48px;
    overflow: visible;
  }
  .fin__edges path {
    fill: none;
    stroke: rgba(245, 245, 240, 0.5);
    stroke-width: 1.2;
    stroke-dasharray: 200;
  }
  .fin__edges .soft {
    stroke: rgba(198, 161, 91, 0.35);
    stroke-dasharray: 3 5;
  }
  .fin__hub {
    fill: var(--gold);
  }
  .fin__halo {
    fill: none;
    stroke: rgba(198, 161, 91, 0.4);
    animation: breathe 3.2s ease-in-out infinite;
    transform-origin: 200px 150px;
  }
  @keyframes breathe {
    50% {
      transform: scale(1.25);
      opacity: 0.3;
    }
  }
  .fin__node {
    fill: #f5f5f0;
  }
  .fin__title {
    font-family: var(--f-serif);
    font-size: clamp(56px, 10vw, 170px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 400;
    margin: 24px 0 28px;
  }
  .fin__title em {
    color: var(--gold);
  }
  .fin__ask {
    font-size: clamp(22px, 2.4vw, 34px);
    letter-spacing: -0.025em;
    font-weight: 500;
    margin: 0 0 14px;
  }
  .fin__lede {
    max-width: 46ch;
    color: rgba(245, 245, 240, 0.7);
    font-size: 18px;
    margin: 0 0 40px;
  }
  .fin__ctas {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }
  .fin__mail {
    border-bottom: 1px solid rgba(245, 245, 240, 0.4);
    padding-bottom: 3px;
    transition: color 0.3s, border-color 0.3s;
  }
  .fin__mail:hover {
    color: var(--gold);
    border-color: var(--gold);
  }
  .fin__meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    width: 100%;
    max-width: 900px;
    margin: 90px 0 0;
    padding-top: 28px;
    border-top: 1px solid rgba(245, 245, 240, 0.14);
    text-align: left;
  }
  .fin__meta dt {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(245, 245, 240, 0.5);
    margin-bottom: 8px;
  }
  .fin__meta dd {
    margin: 0;
  }
  @media (max-width: 700px) {
    .fin__meta {
      grid-template-columns: 1fr;
    }
  }
</style>
