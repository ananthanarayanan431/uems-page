---
// The UEMS equity-node mark: four stakeholders bound to one company node.
interface Props {
  size?: number;
  class?: string;
}
const { size = 34, class: cls = '' } = Astro.props;
---
<svg
  class={`logo-mark ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  aria-hidden="true"
>
  <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
    <path d="M20 5 L34 20 L20 35 L6 20 Z" opacity=".45" />
    <path d="M20 5 L20 35 M6 20 L34 20" opacity=".25" />
  </g>
  <circle cx="20" cy="5" r="3.2" fill="currentColor" />
  <circle cx="34" cy="20" r="3.2" fill="currentColor" />
  <circle cx="20" cy="35" r="3.2" fill="currentColor" />
  <circle cx="6" cy="20" r="3.2" fill="currentColor" />
  <circle cx="20" cy="20" r="4.6" fill="#C6A15B" />
</svg>
