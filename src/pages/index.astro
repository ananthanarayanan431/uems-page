>
  <Hero />
  <NodeDivider />
  <Paths />
  <Services />
  <Process />
  <Industries />
  <Clarity />
  <Lifecycle />
  <NodeDivider />
  <div style="height: clamp(80px, 10vw, 140px)"></div>
