---
import { content, rich } from '../lib/content';
import Base from '../layouts/Base.astro';
import FinalCta from '../components/FinalCta.astro';
import NodeDivider from '../components/NodeDivider.astro';

const c = await content('about');
---
<Base title={c.seo.title} description={c.seo.description}>
  <section class="ah" data-theme="light">
    <div class="wrap ah__grid">
      <div>
        <p class="eyebrow ah__in">{c.eyebrow}</p>
        <h1 class="ah__title" data-reveal>
          {c.title.map((l) => <span class="split-line"><span>{rich(l).map((p) => (p.em ? <em class="serif">{p.text}</em> : p.text))}</span></span>)}
        </h1>
        <p class="lede ah__in">{c.lede}</p>
      </div>
      <svg class="ah__mark" viewBox="0 0 400 400" aria-hidden="true">
        <g class="ah__spin">
          <circle cx="200" cy="200" r="180" class="ring" />
          <circle cx="200" cy="200" r="120" class="ring dash" />
          <path d="M200 20 L380 200 L200 380 L20 200 Z" class="edge" />
          <path d="M200 20 V380 M20 200 H380" class="edge faint" />
          <circle cx="200" cy="20" r="11" class="n" />
          <circle cx="380" cy="200" r="11" class="n" />
          <circle cx="200" cy="380" r="11" class="n" />
          <circle cx="20" cy="200" r="11" class="n" />
        </g>
        <circle cx="200" cy="200" r="30" class="hub" />
      </svg>
    </div>
  </section>

  <NodeDivider />
  <section class="story" data-theme="light">
    <div class="wrap story__grid">
      <p class="eyebrow" data-fade>{c.story.eyebrow}</p>
      <div>
        <p class="story__big" data-fade>{c.story.big}</p>
        <div class="story__cols">
          <p data-fade>{c.story.paragraphA}</p>
          <p data-fade="0.1">
            <strong>{c.story.missionLabel}</strong> {c.story.missionText}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="model" data-theme="dark">
    <div class="wrap">
      <p class="eyebrow" data-fade>{c.model.eyebrow}</p>
      <h2 class="model__title" data-reveal>
          {c.model.title.map((l) => <span class="split-line"><span>{rich(l).map((p) => (p.em ? <em class="serif">{p.text}</em> : p.text))}</span></span>)}
        </h2>
      <div class="model__flow">
        {c.model.steps.map((m, i) => (
          <div class="model__step" data-fade={i * 0.12}>
            <span class="model__n">0{i + 1}</span>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="agn" data-theme="pale">
    <div class="wrap agn__grid">
      <div>
        <p class="eyebrow" data-fade>{c.agnostic.eyebrow}</p>
        <h2 class="agn__title" data-fade>
          {c.agnostic.title}
        </h2>
        <p class="lede" data-fade>{c.agnostic.lede}</p>
      </div>
      <ul class="agn__list">
        {c.agnostic.verticals.map((v, i) => <li data-fade={i * 0.08}><i></i>{v}</li>)}
      </ul>
    </div>
  </section>

  <section class="vals" data-theme="light">
    <div class="wrap">
      <p class="eyebrow" data-fade>{c.values.eyebrow}</p>
      <div class="vals__grid">
        {c.values.items.map((v, i) => (
          <article class="val" data-fade={i * 0.1} data-cursor="Learn +">
            <svg viewBox="0 0 80 80" aria-hidden="true" class="val__icon">
              <circle cx="40" cy="40" r="34" />
              {i === 0 && <path d="M24 41 L35 52 L57 29" />}
              {i === 1 && <><circle cx="40" cy="40" r="12" /><circle cx="40" cy="40" r="3" class="fill" /></>}
              {i === 2 && <><rect x="27" y="36" width="26" height="20" rx="3" /><path d="M32 36 V30 a8 8 0 0 1 16 0 V36" /></>}
            </svg>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </article>
        ))}
      </div>

      <div class="reasons">
        <h2 class="reasons__title" data-fade>{c.reasons.title}</h2>
        <ol>
          {c.reasons.items.map((r, i) => (
            <li data-fade={i * 0.08}><span>0{i + 1}</span>{r}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <FinalCta eyebrow={c.ctaEyebrow} />
</Base>

<script>
  import { gsap } from 'gsap';
  import { reduced, pageReady } from '../scripts/site';
  if (!reduced) pageReady.then(() => {
    gsap.from('.ah__in', { y: 24, opacity: 0, duration: 1, stagger: 0.15, delay: 0.3, ease: 'expo.out' });
    gsap.from('.ah__mark .n', { scale: 0, transformOrigin: 'center', duration: 0.8, stagger: 0.1, delay: 0.4, ease: 'back.out(2)' });
    gsap.from('.ah__mark .hub', { scale: 0, transformOrigin: 'center', duration: 1.2, delay: 0.2, ease: 'elastic.out(1,0.5)' });
    gsap.to('.ah__mark', {
      rotate: 25,
      ease: 'none',
      scrollTrigger: { trigger: '.ah', start: 'top top', end: 'bottom top', scrub: true },
    });
  });
</script>

<style>
  .ah {
    min-height: 92svh;
    display: flex;
    align-items: center;
    padding: 140px 0 80px;
  }
  .ah__grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 60px;
    align-items: center;
  }
  .ah__title {
    font-family: var(--f-serif);
    font-size: clamp(38px, 6vw, 104px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--forest);
    margin: 24px 0 32px;
  }
  .ah__title em {
    color: var(--emerald);
  }
  .ah__mark {
    width: 100%;
    max-width: 420px;
    overflow: visible;
    justify-self: end;
  }
  .ah__spin {
    transform-origin: 200px 200px;
    animation: rot 60s linear infinite;
  }
  @keyframes rot {
    to {
      transform: rotate(360deg);
    }
  }
  .ah__mark .ring {
    fill: none;
    stroke: var(--forest);
    stroke-opacity: 0.15;
  }
  .ah__mark .dash {
    stroke-dasharray: 3 7;
    stroke-opacity: 0.35;
  }
  .ah__mark .edge {
    fill: none;
    stroke: var(--forest);
    stroke-width: 1.4;
    stroke-opacity: 0.6;
  }
  .ah__mark .faint {
    stroke-opacity: 0.2;
  }
  .ah__mark .n {
    fill: var(--forest);
  }
  .ah__mark .hub {
    fill: var(--gold);
  }

  .story {
    padding: clamp(80px, 10vw, 140px) 0;
  }
  .story__grid {
    display: grid;
    grid-template-columns: 0.4fr 1fr;
    gap: 40px;
  }
  .story__big {
    font-family: var(--f-serif);
    font-size: clamp(30px, 3.8vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--forest);
    margin: 0 0 56px;
    max-width: 22ch;
  }
  .story__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    color: var(--fg-muted);
  }
  .story__cols p {
    margin: 0;
  }
  .story__cols strong {
    color: var(--forest);
    font-weight: 600;
  }

  .model {
    padding: clamp(120px, 14vw, 200px) 0;
    color: #f5f5f0;
  }
  .model__title {
    font-family: var(--f-serif);
    font-size: clamp(44px, 6.4vw, 104px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 400;
    margin: 24px 0 80px;
  }
  .model__title em {
    color: var(--gold);
  }
  .model__flow {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    position: relative;
  }
  .model__flow::before {
    content: '';
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 1px;
    background: rgba(245, 245, 240, 0.2);
  }
  .model__step {
    padding-right: 32px;
    position: relative;
  }
  .model__step::before {
    content: '';
    display: block;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--gold);
    margin-bottom: 36px;
  }
  .model__n {
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--gold);
  }
  .model__step h3 {
    font-size: clamp(24px, 2.4vw, 34px);
    letter-spacing: -0.03em;
    font-weight: 500;
    margin: 10px 0 12px;
  }
  .model__step p {
    margin: 0;
    color: rgba(245, 245, 240, 0.68);
    max-width: 34ch;
  }

  .agn {
    padding: clamp(120px, 14vw, 180px) 0;
  }
  .agn__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: end;
  }
  .agn__title {
    font-family: var(--f-serif);
    font-size: clamp(32px, 3.8vw, 58px);
    line-height: 1;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--forest);
    margin: 24px 0 24px;
    max-width: 18ch;
  }
  .agn__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .agn__list li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
    font-size: clamp(20px, 2vw, 28px);
    letter-spacing: -0.02em;
    color: var(--forest);
  }
  .agn__list i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--emerald);
  }

  .vals {
    padding: clamp(120px, 14vw, 180px) 0 clamp(80px, 10vw, 140px);
  }
  .vals__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .val {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 40px 32px;
    transition: transform 0.6s var(--ease), border-color 0.4s;
  }
  .val:hover {
    transform: translateY(-6px);
    border-color: var(--emerald);
  }
  .val__icon {
    width: 64px;
    fill: none;
    stroke: var(--forest);
    stroke-width: 1.5;
    margin-bottom: 56px;
  }
  .val__icon circle:first-child {
    stroke: var(--gold);
  }
  .val__icon .fill {
    fill: var(--gold);
    stroke: none;
  }
  .val h3 {
    font-size: 26px;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--forest);
    margin: 0 0 12px;
  }
  .val p {
    margin: 0;
    color: var(--fg-muted);
  }
  .reasons {
    display: grid;
    grid-template-columns: 0.6fr 1fr;
    gap: 40px;
    margin-top: clamp(80px, 10vw, 140px);
  }
  .reasons__title {
    font-family: var(--f-serif);
    font-size: clamp(32px, 3.6vw, 52px);
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--forest);
    margin: 0;
  }
  .reasons ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reasons li {
    display: grid;
    grid-template-columns: 48px 1fr;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
    font-size: clamp(18px, 1.6vw, 22px);
    letter-spacing: -0.015em;
  }
  .reasons li:first-child {
    border-top: 1px solid var(--rule);
  }
  .reasons li span {
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--gold);
    padding-top: 6px;
  }

  @media (max-width: 900px) {
    .ah__grid,
    .story__grid,
    .story__cols,
    .agn__grid,
    .reasons,
    .vals__grid,
    .model__flow {
      grid-template-columns: 1fr;
    }
    .ah__mark {
      max-width: 240px;
      justify-self: start;
      order: -1;
    }
    .model__flow {
      gap: 48px;
    }
    .model__flow::before {
      display: none;
    }
  }
</style>
