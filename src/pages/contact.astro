---
import Base from '../layouts/Base.astro';
---
<Base
  title="Request a Consultation | Universal Equity Management Solutions"
  description="Book a 15-minute introductory session with UEMS equity specialists. Offices in Hyderabad, Mumbai and Bangalore."
>
  <section class="ct" data-theme="light">
    <div class="wrap ct__grid">
      <div>
        <p class="eyebrow">Contact & consultation</p>
        <h1 class="ct__title" data-reveal>
          <span class="split-line"><span>Let’s structure</span></span>
          <span class="split-line"><span><em class="serif">what’s next.</em></span></span>
        </h1>
        <p class="lede">
          Ready to digitise and optimise your corporate equity structure? Schedule a 15-minute
          introductory session with our equity specialists.
        </p>
        <dl class="ct__meta">
          <div><dt>Email</dt><dd><a href="mailto:contact@yourfirm.com">contact@yourfirm.com</a></dd></div>
          <div><dt>Phone</dt><dd><a href="tel:+18005550199">+1 (800) 555-0199</a></dd></div>
          <div><dt>Offices</dt><dd>Hyderabad · Mumbai · Bangalore</dd></div>
        </dl>
      </div>

      <form class="form" data-form novalidate>
        <p class="form__k">Request a consultation</p>
        <label>
          <span>Full name</span>
          <input name="name" required autocomplete="name" />
        </label>
        <label>
          <span>Company</span>
          <input name="company" required autocomplete="organization" />
        </label>
        <label>
          <span>Work email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <fieldset>
          <legend>What do you need help with?</legend>
          <div class="chips">
            {['Equity structuring', 'Capital facilitation', 'Cap-table management', 'ESOP', 'Transaction support', 'Not sure yet'].map((c) => (
              <label class="chip"><input type="checkbox" name="topic" value={c} /><span>{c}</span></label>
            ))}
          </div>
        </fieldset>
        <label>
          <span>Anything we should know?</span>
          <textarea name="message" rows="4"></textarea>
        </label>
        <button class="btn" type="submit" data-cursor="Send →">
          Send request <span class="arrow" aria-hidden="true">→</span>
        </button>
        <p class="form__note" data-form-note role="status">
          Opens your email client with the details filled in.
        </p>
      </form>
    </div>
  </section>
</Base>

<script>
  // Static site: compose the request as an email rather than posting to a server.
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const note = document.querySelector<HTMLElement>('[data-form-note]')!;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const missing = ['name', 'company', 'email'].filter((k) => !String(fd.get(k) || '').trim());
    if (missing.length) {
      note.textContent = 'Please add your name, company and email.';
      form.querySelector<HTMLInputElement>(`[name="${missing[0]}"]`)?.focus();
      return;
    }
    const topics = fd.getAll('topic').join(', ') || 'Not specified';
    const body = [
      `Name: ${fd.get('name')}`,
      `Company: ${fd.get('company')}`,
      `Email: ${fd.get('email')}`,
      `Topics: ${topics}`,
      '',
      String(fd.get('message') || ''),
    ].join('\n');
    const subject = `Consultation request: ${fd.get('company')}`;
    window.location.href = `mailto:contact@yourfirm.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    note.textContent = 'Your email client should open now. Thank you.';
  });
</script>

<style>
  .ct {
    padding: 160px 0 clamp(100px, 12vw, 160px);
  }
  .ct__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
  }
  .ct__title {
    font-family: var(--f-serif);
    font-size: clamp(48px, 7vw, 116px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--forest);
    margin: 24px 0 28px;
  }
  .ct__title em {
    color: var(--emerald);
  }
  .ct__meta {
    margin: 56px 0 0;
    border-top: 1px solid var(--rule);
  }
  .ct__meta div {
    display: grid;
    grid-template-columns: 110px 1fr;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  .ct__meta dt {
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-top: 4px;
  }
  .ct__meta dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .ct__meta a:hover {
    color: var(--emerald);
  }

  .form {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(24px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .form__k {
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0;
  }
  .form label > span,
  .form legend {
    display: block;
    font-size: 13px;
    color: var(--fg-muted);
    margin-bottom: 8px;
  }
  .form input:not([type='checkbox']),
  .form textarea {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--ink-30);
    padding: 8px 0 10px;
    border-radius: 0;
    transition: border-color 0.3s;
    resize: vertical;
  }
  .form input:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--emerald);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    position: relative;
  }
  .chip input {
    position: absolute;
    opacity: 0;
  }
  .chip span {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 99px;
    border: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink) !important;
    margin: 0 !important;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
    cursor: pointer;
  }
  .chip input:checked + span {
    background: var(--forest);
    color: var(--ivory) !important;
    border-color: var(--forest);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .form .btn {
    align-self: flex-start;
    margin-top: 6px;
  }
  .form__note {
    margin: 0;
    font-size: 13px;
    color: var(--fg-muted);
  }
  @media (max-width: 900px) {
    .ct {
      padding-top: 120px;
    }
    .ct__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
